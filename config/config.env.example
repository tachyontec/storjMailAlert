#
# StorjMailAlert Configuration
# Copy this file to ../config.env and edit with your settings
#

# ------------------------------------------------------------------------------
# Email Configuration
# ------------------------------------------------------------------------------

# Email address to receive alerts
ALERT_EMAIL="your-email@example.com"

# ------------------------------------------------------------------------------
# Check Intervals
# ------------------------------------------------------------------------------

# How often checks run (in minutes) - used for cron scheduling
CHECK_INTERVAL=15

# ------------------------------------------------------------------------------
# Thresholds
# ------------------------------------------------------------------------------

# Minimum error percentage to trigger an alert (0-100)
ERROR_PERCENT_THRESHOLD=5

# ------------------------------------------------------------------------------
# Machine Role
# ------------------------------------------------------------------------------

# Set to 'true' if this machine runs Storj storage nodes
# This enables:
#   - Local docker log checking
#   - Local disk mount checking
#   - Self-repair capabilities (auto-restart containers, remount disks)
#
# Set to 'false' if this is a monitoring-only machine
# This enables:
#   - Remote HTTP status checking only
#   - No local checks or self-repair
#
IS_NODE_OPERATOR=true

# ------------------------------------------------------------------------------
# Feature Toggles
# ------------------------------------------------------------------------------

# Check docker logs for errors (requires IS_NODE_OPERATOR=true)
ENABLE_LOG_CHECK=true

# Check node HTTP status via dashboard ports
ENABLE_NODE_CHECK=true

# Check disk mounts (requires IS_NODE_OPERATOR=true)
ENABLE_DISK_CHECK=true

# Check and repair NOIP dynamic DNS
ENABLE_NOIP_CHECK=false

# ------------------------------------------------------------------------------
# Docker Configuration
# ------------------------------------------------------------------------------

# Docker container name prefix
# Your containers should be named: storagenode, storagenode2, storagenode3, etc.
CONTAINER_PREFIX="storagenode"

# ------------------------------------------------------------------------------
# Advanced Settings (usually don't need to change)
# ------------------------------------------------------------------------------

# Enable debug logging
DEBUG=false

# Custom paths (leave empty to use defaults)
# LOG_DIR=""
# TMP_DIR=""
