# StorjMailAlert - Ansible Inventory
#
# This file is auto-generated by setup-multi.sh
# You can also create it manually.
#
# Each host name MUST match the /etc/hostname on that machine,
# as StorjMailAlert uses hostname matching for self-repair.
#
# If the control machine (where you run Ansible) is also a Storj node,
# add ansible_connection=local to skip SSH for that host.

[storj_nodes]
# node1  ansible_host=node1.ddns.net  ansible_port=22  ansible_user=storj
# node2  ansible_host=node2.ddns.net  ansible_port=22  ansible_user=storj
# node3  ansible_host=192.168.1.10   ansible_port=22  ansible_user=storj  ansible_connection=local
